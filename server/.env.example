# ===== my-react 后台环境配置模板 =====
# 复制为 .env 后填写（.env 已被 gitignore，不会提交）

# 服务端口
PORT=3000

# MongoDB 连接串（Zeabur 里创建 MongoDB 服务后复制）
# 留空则使用「内存模式」（仅本地开发调试，重启丢数据）
MONGODB_URI=

# DeepSeek API Key（后台持有，前端永远不携带）
DEEPSEEK_API_KEY=sk-xxxx

# JWT 签名密钥（生产务必换成随机长字符串）
JWT_SECRET=change-me-to-a-long-random-string

# 允许跨域的前端来源，多个用逗号分隔；留空 = 允许所有（仅开发）
# 生产示例：ALLOWED_ORIGIN=https://gecaitao.github.io,http://localhost:5174
ALLOWED_ORIGIN=

# 是否打印请求日志（开发 true，生产 false）
LOG_REQUESTS=true
