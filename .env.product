# =============================================================
# 生产环境配置（npm run build / dev:product）
# 部署到线上时使用本文件的常量与请求连接
# =============================================================

# 环境标识
VITE_APP_MODE=product

# 应用标题
VITE_APP_TITLE=My React

# 生产 API 地址（指向你在 Zeabur 部署的 Node 后台，部署后替换）
# TODO: 替换为真实地址，如 https://my-react-backend.zeabur.app/api
VITE_API_BASE_URL=https://api.example.com

