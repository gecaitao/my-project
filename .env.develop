# =============================================================
# 开发环境配置（npm run dev / build:develop）
# 本地开发时使用本文件的常量与请求连接
# =============================================================

# 环境标识
VITE_APP_MODE=develop

# 应用标题（开发环境可加标识便于区分）
VITE_APP_TITLE=My React (Dev)

# 本地开发 API 地址（指向本地 Node 后台，见 server/ 目录）
VITE_API_BASE_URL=http://localhost:3000/api

